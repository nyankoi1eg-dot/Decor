{
  "mcpServers": {
    "google-analytics": {
      "command": "bash",
      "args": ["-c", "exec \"${CLAUDE_PROJECT_DIR:-$PWD}/.claude/mcp/ga4-launch.sh\""],
      "env": {
        "GA_MCP_TELEMETRY": "false"
      }
    },
    "gtm": {
      "type": "http",
      "url": "http://127.0.0.1:8391/",
      "headers": {
        "Authorization": "Bearer ${GTM_MCP_API_KEY}"
      }
    }
  }
}
