# Token de API de Botmaker (go.botmaker.com -> Integraciones -> API)
BOTMAKER_ACCESS_TOKEN=

# Zona horaria de negocio para agrupar por dia
BI_TIMEZONE_OFFSET=-5

# Clave que deben enviar los consumidores del endpoint (header X-API-Key)
BI_API_KEY=

# SQL Server (solo para el cargador; el endpoint REST no lo necesita)
MSSQL_CONN=Driver={ODBC Driver 18 for SQL Server};Server=tcp:HOST,1433;Database=BI;UID=user;PWD=pass;Encrypt=yes
